APP_NAME=VetorOs
APP_ENV=local
APP_KEY=
# Chaves APP_KEY anteriores durante uma rotação, separadas por vírgula.
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database


#WAHA (WhatsApp HTTP API) - cada tenant conecta seu próprio número via QR Code
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
WAHA_WEBHOOK_URL=
WAHA_WEBHOOK_SECRET=

# Token Bearer do CRM ABrasil para POST /api/integrations/registration-check (vazio = endpoint nega tudo)
CRM_REGISTRATION_CHECK_TOKEN=
VETORLEADS_WEB_CHAT_URL=
VETORLEADS_WEB_CHAT_TOKEN=

# Emissão fiscal nativa (Spedy). Sem a chave da empresa titular a emissão fica indisponível
# e o registro manual continua funcionando. sandbox | production (contas e chaves separadas).
SPEDY_ENVIRONMENT=sandbox
SPEDY_OWNER_API_KEY=
# Segredo whsec_... de GET /v1/webhooks/secret (vazio = webhook recusa tudo)
SPEDY_WEBHOOK_SECRET=
SPEDY_TIMEOUT=30
# Responsável técnico (infRespTec) da NF-e/NFC-e; vazio = a Spedy assume
SPEDY_TECH_RESPONSIBLE_CNPJ=
SPEDY_TECH_RESPONSIBLE_NAME=
SPEDY_TECH_RESPONSIBLE_EMAIL=
SPEDY_TECH_RESPONSIBLE_PHONE=

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP institucional da plataforma (RootAdmin e avisos do SaaS). A senha vem do ambiente
# (no infra-abrasil: ABRASIL_MAIL_PASSWORD no .env da VPS); nunca preencha aqui.
# Cada empresa usa o próprio SMTP, configurado em Sistema e módulos.
MAIL_MAILER=smtp
ABRASIL_MAIL_HOST=smtp.hostinger.com
ABRASIL_MAIL_PORT=465
ABRASIL_MAIL_ENCRYPTION=ssl
ABRASIL_MAIL_USERNAME=contato@abrasilsistemas.com.br
ABRASIL_MAIL_PASSWORD=
ABRASIL_MAIL_FROM_ADDRESS=contato@abrasilsistemas.com.br
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# A versão exibida no rodapé vem de package.json ("version"); VITE_APP_VERSION não é mais usado.
VITE_APP_URL="${APP_URL}"

# Exibição pública dos preços (valores da tabela plans). Desligada por decisão comercial.
PUBLIC_PRICES_ENABLED=false

# Diretório privado e persistente para XML/PDF das notas autorizadas
FISCAL_STORAGE_ROOT=
