# Análise estática (VETOROS-SECURITY-FIX-01). Os erros já existentes antes da adoção estão em
# phpstan-baseline.neon; código novo ou alterado não deve acrescentar erros.
includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app/
    tmpDir: storage/framework/cache/phpstan
