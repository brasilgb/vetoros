# Modelo da configuração exclusiva dos testes (VETOR-STABILIZE-01). Copie para .env.testing
# e gere a chave só dos testes: cp .env.testing.example .env.testing && php artisan key:generate --env=testing
# Não contém credenciais reais; o banco é sempre sqlite em memória (tests/TestCase.php aborta se não for).
APP_NAME=VetorOS
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

BCRYPT_ROUNDS=4
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Integrações externas desligadas: cada teste configura o que precisa e usa Http::fake.
SPEDY_ENVIRONMENT=sandbox
SPEDY_OWNER_API_KEY=
SPEDY_WEBHOOK_SECRET=
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PUBLIC_PRICES_ENABLED=false
